    "@babel/core": "8.1.2",
    "@babel/plugin-transform-runtime": "8.1.2",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.7",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@mui/styled-engine-sc": "9.5.0",
    "@rollup/plugin-alias": "6.0.1",
    "@rollup/plugin-babel": "7.1.0",
    "@rollup/plugin-commonjs": "29.0.3",
